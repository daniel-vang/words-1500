{
  "name": "words-1500",
  "version": "1.0.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "dist:win": "electron-builder --win --publish=never"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "build": {
    "appId": "com.words1500.app",
    "productName": "Words 1500",
    "asar": true,
    "publish": null,
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "sw.js",
      "manifest.webmanifest",
      "words-*.js",
      "words-*.json",
      "*.txt",
      "electron-main.js",
      "tesseract.min.js",
      "tesseract.worker.min.js",
      "tessdata/**",
      "tesseract-core/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to check spoken answers."
      }
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
